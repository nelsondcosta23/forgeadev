# --- Proxy BFF Configuration ---
PORT=8085

# --- PocketBase Configuration ---
# Use o nome do serviço definido no docker-compose se estiver no mesmo Docker Network
POCKETBASE_URL=http://pb:8090

# --- AI Integration (Primary: Mistral AI) ---
# Obtenha em https://console.mistral.ai/
MISTRAL_API_KEY=sua_chave_mistral_aqui
MISTRAL_MODEL=mistral-large-latest

# --- AI Integration (Fallback: Google Gemini API) ---
# Usada como fallback automático caso a Mistral AI falhe ou atinja limites
GEMINI_API_KEY=sua_chave_api_do_google_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Sentry Error Monitoring ---
# Em desenvolvimento local:
# SENTRY_DSN=http://994ebcb62592da248c0fa74514c61fa7@localhost:9000/8
# No Coolify (produção via Tailscale, use o IP da sua máquina no Tailscale ou MagicDNS):
# SENTRY_DSN=http://994ebcb62592da248c0fa74514c61fa7@100.x.y.z:9000/8
SENTRY_DSN=http://994ebcb62592da248c0fa74514c61fa7@localhost:9000/8
